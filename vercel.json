{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash app/tool/vercel_build.sh",
  "outputDirectory": "app/build/web",
  "rewrites": [
    { "source": "/email-confirmed", "destination": "/index.html" },
    { "source": "/email-confirmed/", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/reset-password/", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy/", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/terms/", "destination": "/index.html" }
  ]
}
