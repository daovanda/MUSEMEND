{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/email-confirmed", "destination": "/index.html" },
    { "source": "/email-confirmed/", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/reset-password/", "destination": "/index.html" }
  ]
}
